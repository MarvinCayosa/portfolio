// Prisma schema — PostgreSQL models for portfolio content and contact submissions.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  tags        String[]
  url         String?
  repoUrl     String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Experience {
  id        Int       @id @default(autoincrement())
  company   String
  role      String
  startDate DateTime
  endDate   DateTime?
  current   Boolean   @default(false)
  bullets   String[]
  order     Int
}

model Education {
  id          Int     @id @default(autoincrement())
  degree      String
  institution String
  year        Int
  notes       String?
}

model Award {
  id     Int    @id @default(autoincrement())
  title  String
  issuer String
  year   Int
}
